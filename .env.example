# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here

# Supabase Credentials (Database only; RLS disabled, server is access control layer)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key

# Webhook & Public URLs
WEBHOOK_URL=https://your-app-domain.onrender.com
WEBAPP_URL=https://your-app-domain.onrender.com/webapp
PUBLIC_BASE_URL=https://your-app-domain.onrender.com

# Server Port & CORS
PORT=10000
ALLOWED_ORIGINS=https://web.telegram.org,https://your-app-domain.onrender.com

# Upload Safeguards
MAX_UPLOAD_FILE_SIZE_MB=50
MAX_UPLOAD_BATCH_FILES=20
MAX_UPLOAD_BATCH_MB=100

# Security & Development Flags (Production must keep DEV_AUTH_ENABLED=false)
DEV_AUTH_ENABLED=false
DEV_USER_ID=0
INIT_DATA_MAX_AGE_SECONDS=86400
